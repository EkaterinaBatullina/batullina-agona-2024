<?xml version="1.0" encoding="UTF-8"?>
<plugin>
    <name>CheckComments Plugin</name>
    <goalPrefix>check-comments</goalPrefix>
    <mojos>
        <mojo>
            <goal>check-comments</goal>
            <implementation>org.example.CheckCommentsMojo</implementation>
            <description>Плагин для проверки комментариев в файлах</description>
            <phase>validate</phase>
            <executions>
                <execution>
                    <goals>
                        <goal>check-comments</goal>
                    </goals>
                </execution>
            </executions>
        </mojo>
    </mojos>
</plugin>
